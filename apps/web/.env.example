# Copy to apps/web/.env.local and fill in. Never commit real values.
# Every value below is a placeholder.

# --- Supabase --------------------------------------------------------------
# Local: `npm run db:start` prints the URL and keys (or run `npx supabase@3 status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon / publishable key. Safe for browsers; RLS does the protecting.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The service-role / secret key. SERVER ONLY. Bypasses RLS: used for order
# placement, payment webhooks and payment-account writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection, used only by `npm run db:seed`.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- M-Tickets -------------------------------------------------------------
# Signs ticket QR codes. 32+ random characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates printed QR codes (typed ticket codes keep working).
TICKETS_QR_SECRET=replace-with-32-plus-random-characters-before-use
# How long an unpaid checkout holds seats, in minutes (31-120).
TICKETS_HOLD_MINUTES=35
# Encrypts each order's ticket link until its confirmation email is sent.
# 32+ random characters, different from TICKETS_QR_SECRET (same command).
# Changing it only means pending confirmations go out with a fresh link.
TICKETS_DELIVERY_KEY=replace-with-32-plus-random-characters-before-use

# --- Email (Resend) ----------------------------------------------------------
# Leave both empty in development: emails are printed to the server log
# instead, ticket links included. Both are required in production.
# TICKETS_EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
TICKETS_EMAIL_FROM=
# Optional Reply-To for buyer replies, e.g. a support inbox.
TICKETS_EMAIL_REPLY_TO=

# --- Cron --------------------------------------------------------------------
# Protects GET /api/cron/tickets (send queued email, release abandoned holds).
# Call it every 5 minutes with "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron sends that header automatically when CRON_SECRET is set.
CRON_SECRET=

# --- Stripe (leave empty to run RSVP-only) ---------------------------------
# TEST MODE keys only outside production (sk_test_...); the app refuses
# sk_live_ keys unless NODE_ENV=production.
STRIPE_SECRET_KEY=
# Signing secret of the CONNECT webhook endpoint ("Events on connected
# accounts"). Locally, `npm run stripe:listen` prints a whsec_ value.
STRIPE_CONNECT_WEBHOOK_SECRET=
# standard (recommended) or express. See packages/m-tickets/README.md.
STRIPE_CONNECT_ACCOUNT_TYPE=standard
